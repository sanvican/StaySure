generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(uuid())
  username         String           @unique
  email            String           @default("")
  passwordHash     String
  role             String           @default("GUEST") // HOST | GUEST | ADMIN
  walletAddress    String?
  identityVerified Boolean          @default(false)
  createdAt        DateTime         @default(now())

  properties       Property[]       @relation("HostProperties")
  captureSessions  CaptureSession[] @relation("HostSessions")
  bookings         Booking[]        @relation("GuestBookings")
  reviews          Review[]         @relation("GuestReviews")
}

model Property {
  id             String    @id @default(uuid())
  hostId         String
  name           String
  description    String    @default("")
  city           String    @default("")
  bedrooms       Int       @default(1)
  bathrooms      Int       @default(1)
  maxGuests      Int       @default(2)
  amenities      String    @default("[]") // JSON array of amenity labels
  address        String
  unitNumber     String    @default("")
  building       String    @default("")
  latitude       Float
  longitude      Float
  price          Float
  fingerprint    String    @unique
  status         String    @default("PENDING") // PENDING | VERIFIED | DUE_SOON | EXPIRED | UNDER_REVIEW | REJECTED
  lastVerifiedAt DateTime?
  registerTx     String?
  needsReview    Boolean   @default(false)
  createdAt      DateTime  @default(now())

  host                User                 @relation("HostProperties", fields: [hostId], references: [id])
  captureSessions     CaptureSession[]
  submissions         Submission[]
  photos              Photo[]
  verificationRecords VerificationRecord[]
  bookings            Booking[]
  reviews             Review[]

  @@index([hostId])
  @@index([status])
}

model CaptureSession {
  id            String   @id @default(uuid())
  propertyId    String
  hostId        String
  nonce         String
  requiredViews String   // JSON array: ["living_room","bedroom","bathroom"]
  expiresAt     DateTime
  used          Boolean  @default(false)
  createdAt     DateTime @default(now())

  property   Property    @relation(fields: [propertyId], references: [id])
  host       User        @relation("HostSessions", fields: [hostId], references: [id])
  submission Submission?

  @@index([propertyId])
}

model Submission {
  id              String   @id @default(uuid())
  propertyId      String
  sessionId       String   @unique
  processingState String   @default("RECEIVED") // RECEIVED | VALIDATING | PENDING_REVIEW | APPROVED | CHAIN_SUBMITTED | CONFIRMED | FAILED | REJECTED
  failureReason   String   @default("")
  similarFlag     Boolean  @default(false)
  txHash          String?
  createdAt       DateTime @default(now())

  property           Property            @relation(fields: [propertyId], references: [id])
  session            CaptureSession      @relation(fields: [sessionId], references: [id])
  photos             Photo[]
  verificationRecord VerificationRecord?

  @@index([propertyId])
  @@index([processingState])
}

model Photo {
  id           String   @id @default(uuid())
  submissionId String
  propertyId   String
  viewLabel    String
  filePath     String
  sha256       String
  phash        String
  latitude     Float
  longitude    Float
  capturedAt   DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id])
  property   Property   @relation(fields: [propertyId], references: [id])

  @@index([submissionId])
  @@index([propertyId])
  @@index([sha256])
}

model VerificationRecord {
  id           String   @id @default(uuid())
  propertyId   String
  submissionId String   @unique
  recordIndex  Int
  merkleRoot   String
  metadataHash String
  txHash       String
  blockNumber  Int
  createdAt    DateTime @default(now())

  property   Property   @relation(fields: [propertyId], references: [id])
  submission Submission @relation(fields: [submissionId], references: [id])

  @@unique([propertyId, recordIndex])
}

model Booking {
  id         String   @id @default(uuid())
  guestId    String
  propertyId String
  checkIn    DateTime
  checkOut   DateTime
  totalPrice Float
  status     String   @default("CONFIRMED") // CONFIRMED | CANCELLED
  createdAt  DateTime @default(now())

  guest    User     @relation("GuestBookings", fields: [guestId], references: [id])
  property Property @relation(fields: [propertyId], references: [id])

  @@index([propertyId, status])
}

model Review {
  id         String   @id @default(uuid())
  propertyId String
  guestId    String
  rating     Int      // 1-5
  comment    String   @default("")
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id])
  guest    User     @relation("GuestReviews", fields: [guestId], references: [id])

  @@unique([propertyId, guestId])
  @@index([propertyId])
}
